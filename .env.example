# Variáveis de ambiente do Future Space. Copie para .env e preencha só o que for usar.
# Localmente nenhuma é obrigatória: por padrão os dados ficam em ./data.

# Onde o pipeline grava: local, hf (Hugging Face) ou s3.
FS_STORAGE=local
# Pasta usada quando FS_STORAGE=local.
FS_DATA_DIR=data

# Dataset no Hugging Face (usuario/repositorio). Também é de onde a API lê, se definido.
FS_HF_REPO=
# Token de escrita do Hugging Face: só para publicar. Nunca o coloque no repositório;
# no GitHub ele fica em Settings > Secrets and variables > Actions.
HF_TOKEN=

# URL base alternativa de onde a API lê os arquivos JSON.
FS_DATA_URL=
# Requisições por minuto por IP na API (0 desativa o limite).
FS_RATE_LIMIT_PER_MINUTE=60

# Armazenamento S3 compatível (Cloudflare R2, Backblaze B2...), quando FS_STORAGE=s3.
FS_S3_BUCKET=
FS_S3_ENDPOINT_URL=
FS_S3_PREFIX=
